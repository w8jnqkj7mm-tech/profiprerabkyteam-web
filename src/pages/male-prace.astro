---
import SubLayout from '../layouts/SubLayout.astro';
import { BRAND } from '../data/home';

const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
const STD = '61,50 € s DPH · mimo Bratislavy od 80 € podľa vzdialenosti · zahŕňa konzultáciu a zistenie príčiny, nie samotnú opravu · ďalšia hodina 45 € (55,35 € s DPH) alebo cena za úkon · nad 8 h 35 €/h · materiál zvlášť.';

const JOBS = [
  { name: 'Elektrikár', brand: 'Pán Elektrikár', accent: '#FF6B70',
    tagline: 'Zásuvky, svetlá, ističe — a hliník, ktorý už nemá čo robiť v stene.',
    lead: 'Drobné elektro od výmeny vypínača po dotiahnutie rozvádzača. Väčšie veci vieme nafotiť a naceniť vopred.',
    items: ['Výmena zásuviek a vypínačov', 'Montáž svietidiel a LED pásov', 'Oprava a doplnenie istenia', 'Hľadanie poruchy a skratu', 'Predĺženie rozvodu, nová vetva', 'Odborná prehliadka a skúška (revízia)'],
    price: '50 €', priceLabel: 'výjazd / konzultácia v Bratislave', note: STD },
  { name: 'Vodár', brand: 'Pán Vodár', accent: '#8FA6E6',
    tagline: 'Kvapká, tečie, nehreje. Prídeme skôr, než to zatečie k susedovi.',
    lead: 'Batérie, sifóny, prípojky spotrebičov, drobné úniky. Pri väčšej poruche vieme hneď povedať, čo to bude stáť.',
    items: ['Výmena batérií a sifónov', 'Oprava WC a splachovania', 'Prípojka práčky a umývačky', 'Výmena ventilov a hadíc', 'Odstránenie úniku vody', 'Montáž sanity'],
    price: '50 €', priceLabel: 'výjazd / konzultácia v Bratislave', note: STD },
  { name: 'Hodinový majster', brand: 'Profi Prerábky', accent: '#51AE4B',
    tagline: 'Všetko ostatné, čo nie je na celý deň.',
    lead: 'Drobné práce všetkého druhu — od pár kusov dlažby po dvere, ktoré nedoliehajú.',
    items: ['Výmena pár kusov dlažby', 'Opravy podláh a líšt', 'Nastavenie a oprava dverí', 'Montáž nábytku a políc', 'Vŕtanie, kotvenie, zavesenie', 'Drobné murárske opravy'],
    price: '50 €', priceLabel: 'výjazd / konzultácia v Bratislave', note: STD },
  { name: 'Klimatizácia', brand: 'Pán Elektrikár', accent: '#FF6B70',
    tagline: 'Predávame aj montujeme. Jednotku vieme dodať aj samostatne.',
    lead: 'Montáž split jednotiek do bytu, domu aj prevádzky. Pre firmy dodávame jednotky aj vo väčšom množstve.',
    items: ['Montáž split jednotky', 'Rozvod medi a odvod kondenzu', 'Elektrické napojenie', 'Predaj samotných jednotiek', 'B2B dodávky vo väčšom', 'Servis a čistenie — od 69 € mimo sezóny, 110 € v sezóne'],
    price: '0 €', priceLabel: 'obhliadka a cenová ponuka v Bratislave',
    note: 'Mimo Bratislavy je obhliadka od 80 € — ak si montáž objednáte, odpočítame vám ju z ceny. Montáž do 3,5 kW (do 3 m rozvodu) od 284,55 € (350 € s DPH). Každý ďalší meter 34,15 € (42 € s DPH). Vyšší výkon na dopyt.' },
];

const PRICES = [
  { label: 'Výjazd / konzultácia v Bratislave (bez práce)', main: '50 €', sub: '61,50 € s DPH' },
  { label: 'Výjazd mimo Bratislavy — podľa vzdialenosti alebo dohody', main: 'od 80 €', sub: 'od 98,40 € s DPH' },
  { label: 'Každá ďalšia hodina alebo cena za úkon', main: '45 €', sub: '55,35 € s DPH' },
  { label: 'Práca dlhšia ako deň (nad 8 h) — za hodinu', main: '35 €', sub: '43,05 € s DPH' },
  { label: 'Doprava po dohode — za kilometer (len pri väčších zákazkách)', main: '0,53 €/km', sub: '0,65 €/km s DPH' },
  { label: 'Montáž klimatizácie do 3,5 kW', main: 'od 284,55 €', sub: 'od 350 € s DPH' },
];

const STEPS = [
  { t: 'Napíšete alebo zavoláte', d: 'Stačí vetou opísať, čo sa deje. Fotka pomôže — podľa nej často vieme povedať cenu vopred.' },
  { t: 'Dohodneme termín', d: 'Ozveme sa do 4 hodín v pracovnom čase a potvrdíme, kedy prídeme. Zvyčajne do pár dní.' },
  { t: 'Prídeme a spravíme', d: 'Majster má auto, náradie aj bežný materiál. Platíte za odpracovaný čas a použitý materiál.' },
];
const j0 = JOBS[0];
---

<SubLayout title="Malé práce a opravy – Profi Prerábky Team" description="Elektrikár, vodár, hodinový majster a klimatizácie v Bratislave. Výjazd 50 € bez DPH, odpoveď do 4 hodín." current="/male-prace">

<section style="padding-block:clamp(56px,7vw,96px) clamp(40px,5vw,64px);max-width:1240px;margin:0 auto;padding-inline:clamp(20px,5vw,64px)">
  <nav class="crumbs" aria-label="Omrvinky"><a href="/">Úvod</a> · Malé práce</nav>
  <h1 style="margin:0;font-weight:600;font-size:clamp(36px,5.6vw,72px);line-height:1.04;letter-spacing:-0.025em;max-width:900px">Malé práce a opravy.<br /><span class="dline" style={`color:${BRAND}`}>Bez čakania na celú rekonštrukciu.</span></h1>
  <p style="margin:28px 0 0;font-size:17px;line-height:1.7;color:rgba(238,240,243,0.7);max-width:620px">Výmena zásuvky, zatekajúca batéria, pár kusov dlažby, montáž klimatizácie. Ak to nie je na celý deň, je to práca pre hodinového majstra — a ten má v tíme aj elektrikára a vodára za chrbtom.</p>
  <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:36px">
    <a href="/kontakt" class="btn" style={`min-height:52px;padding:0 28px;background:${BRAND};color:#0D1215;font-weight:600;font-size:14px;letter-spacing:0.06em`}>Objednať zásah <Fragment set:html={arrow} /></a>
    <a href="https://wa.me/421948536398" class="btn" style="min-height:52px;padding:0 24px;background:#25D366;color:#0D1215;font-weight:600;font-size:14px">WhatsApp</a>
    <a href="tel:+421948536398" class="btn" style="min-height:52px;padding:0 24px;border:1px solid rgba(238,240,243,0.35);font-weight:500;font-size:14px">+421 948 536 398</a>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:28px;margin-top:40px;padding-top:28px;border-top:1px solid rgba(238,240,243,0.12);font-size:14px;color:rgba(238,240,243,0.7)">
    <span>Odpoveď do 4 hodín v pracovnom čase</span>
    <span>Po–Pi 8:30–17:00</span>
    <span>Bratislava a okolie</span>
  </div>
</section>

<section style="padding:0 clamp(20px,5vw,64px) clamp(72px,9vw,120px);max-width:1240px;margin:0 auto">
  <p class="rv kicker" style={`margin:0 0 24px;color:${BRAND}`}>ČO VIEME SPRAVIŤ</p>
  <div class="rv" style="display:flex;flex-wrap:wrap;gap:20px;align-items:stretch">
    <div role="group" aria-label="Výber služby" style="flex:1 1 260px;display:flex;flex-direction:column;gap:10px">
      {JOBS.map((j, i) => (
        <button type="button" class:list={['tab', 'trade-tab', { on: i === 0 }]} data-job={i} aria-pressed={i === 0 ? 'true' : 'false'} style={`--accent:${j.accent};padding:18px 20px;min-height:72px;justify-content:space-between`}>
          <span>
            <span style="display:block;font-size:18px;font-weight:600">{j.name}</span>
            <span style="display:block;font-size:12px;margin-top:4px;opacity:0.7">{j.brand}</span>
          </span>
          <span class="dot" style="width:10px;height:10px;flex:none"></span>
        </button>
      ))}
    </div>

    <div id="job-panel" class="panel" style={`flex:999 1 560px;min-width:0;border-top:3px solid ${j0.accent};padding:clamp(28px,3.4vw,44px);transition:border-color .5s`}>
      <div id="job-body" class="swap" style="display:flex;flex-direction:column;gap:26px">
        <div>
          <h2 id="job-tagline" class="dline" style="font-style:normal;margin:0;font-size:clamp(26px,3vw,34px);line-height:1.2">{j0.tagline}</h2>
          <p id="job-lead" style="margin:14px 0 0;font-size:15px;line-height:1.7;color:rgba(238,240,243,0.7)">{j0.lead}</p>
        </div>
        <ul id="job-items" style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:0 32px">
          {j0.items.map((it) => <li class="job-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={j0.accent} stroke-width="2.4" aria-hidden="true" style="flex:none"><path d="M4 12.5l5 5L20 6.5"></path></svg><span>{it}</span></li>)}
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:flex-end;justify-content:space-between;padding-top:22px;border-top:1px solid rgba(238,240,243,0.12)">
          <div>
            <span style="display:block;font-size:28px;font-weight:600"><span id="job-price">{j0.price}</span> <span id="job-label" style="font-size:14px;font-weight:500;color:rgba(238,240,243,0.7)">{j0.priceLabel}</span></span>
            <span id="job-note" style="display:block;font-size:12px;line-height:1.6;color:rgba(238,240,243,0.5);margin-top:6px;max-width:460px">{j0.note}</span>
          </div>
          <a href="/kontakt" class="btn" style={`min-height:48px;padding:0 24px;background:${BRAND};color:#0D1215;font-weight:600;font-size:14px`}>Objednať <Fragment set:html={arrow} /></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="light-band" style="padding:clamp(72px,9vw,120px) clamp(20px,5vw,64px)">
  <div style="max-width:1240px;margin:0 auto">
    <p class="kicker" style="margin:0 0 20px;color:#2F4858">AKO TO PREBIEHA</p>
    <h2 style="margin:0 0 56px;font-weight:600;font-size:clamp(30px,4vw,52px);letter-spacing:-0.02em;line-height:1.08;color:#0D1215">Tri kroky, <span class="dline">žiadne papierovanie.</span></h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:32px">
      {STEPS.map((s, i) => (
        <div style={`border-top:2px solid ${i === 0 ? '#0D1215' : 'rgba(13,18,21,0.25)'};padding-top:20px`}>
          <span style="font-size:13px;font-weight:600;letter-spacing:0.1em">0{i + 1}</span>
          <h3 style="margin:14px 0 10px;font-size:20px;font-weight:600;color:#0D1215">{s.t}</h3>
          <p style="margin:0;font-size:15px;line-height:1.65;color:#2F4858">{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section style="padding:clamp(72px,9vw,120px) clamp(20px,5vw,64px);max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:20px">
  <div class="rv panel" style="padding:clamp(28px,3.4vw,40px)">
    <p class="eyebrow" style={`margin:0 0 12px;color:${BRAND}`}>CENY</p>
    <h2 class="dline" style="font-style:normal;margin:0 0 24px;font-size:28px;line-height:1.2">Rovnaké pre všetky štyri značky.</h2>
    <ul style="list-style:none;margin:0;padding:0">
      {PRICES.map((p) => (
        <li style="display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:13px 0;border-bottom:1px solid rgba(238,240,243,0.08)">
          <span style="font-size:15px;line-height:1.5;color:rgba(238,240,243,0.86)">{p.label}</span>
          <span style="text-align:right;flex:none">
            <span style="display:block;font-size:19px;font-weight:600">{p.main}</span>
            <span style="display:block;font-size:11px;color:rgba(238,240,243,0.5)">{p.sub}</span>
          </span>
        </li>
      ))}
    </ul>
    <p style="margin:20px 0 0;font-size:12px;line-height:1.7;color:rgba(238,240,243,0.55)">Hlavná cena je bez DPH, pod ňou je cena s DPH (23 %). Materiál sa účtuje zvlášť.</p>
    <a href="/cennik" style={`display:inline-flex;align-items:center;gap:10px;margin-top:18px;min-height:44px;font-size:13px;font-weight:600;letter-spacing:0.1em;color:${BRAND}`}>CELÝ CENNÍK <Fragment set:html={arrow} /></a>
  </div>

  <div class="rv" style="background:linear-gradient(180deg,#3a5768 0%,#2a4150 100%);border-radius:14px;box-shadow:0 0 0 1px rgba(228,237,241,0.14),0 24px 60px rgba(0,0,0,0.38);padding:clamp(28px,3.4vw,40px);display:flex;flex-direction:column;gap:22px">
    <div>
      <p class="eyebrow" style="margin:0 0 12px;color:rgba(238,240,243,0.75)">KAM CHODÍME</p>
      <h2 class="dline" style="font-style:normal;margin:0;font-size:28px;line-height:1.2">Bratislava a okolie.</h2>
    </div>
    <p style="margin:0;font-size:15px;line-height:1.7;color:rgba(238,240,243,0.85)">Celá Bratislava vrátane Devína a Devínskej Novej Vsi, ďalej Pezinok, Ivanka pri Dunaji, Zálesie a okolité obce. [DOPLNIŤ ĎALŠIE OBCE]</p>
    <div style="font-size:13px;line-height:1.7;color:rgba(238,240,243,0.7);background:rgba(13,18,21,0.3);padding:14px 16px">Mimo Bratislavy je výjazd od 80 € — základ, podľa vzdialenosti alebo dohody aj viac. Doprava je v tej cene už zarátaná.</div>
    <div style="margin-top:auto;height:180px;border:1px dashed rgba(238,240,243,0.25);display:flex;align-items:center;justify-content:center;font-size:12px;letter-spacing:0.2em;color:rgba(238,240,243,0.5)">[MAPA PÔSOBNOSTI]</div>
  </div>
</section>

<section style="padding:0 clamp(20px,5vw,64px) clamp(72px,9vw,120px);max-width:1240px;margin:0 auto">
  <div class="panel" style={`border-left:3px solid ${BRAND};padding:clamp(32px,4vw,56px);display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between`}>
    <div>
      <h2 style="margin:0;font-weight:600;font-size:clamp(26px,3.2vw,40px);letter-spacing:-0.02em;line-height:1.1">Máte to rozbité už týždeň?<br /><span class="dline" style={`color:${BRAND}`}>Napíšte nám dnes.</span></h2>
      <p style="margin:16px 0 0;font-size:15px;line-height:1.7;color:rgba(238,240,243,0.7);max-width:480px">Ozveme sa do 4 hodín v pracovnom čase a dohodneme termín.</p>
    </div>
    <a href="/kontakt" class="btn" style={`min-height:54px;padding:0 30px;background:${BRAND};color:#0D1215;font-weight:700;font-size:14px;letter-spacing:0.06em`}>Nezáväzný dopyt <Fragment set:html={arrow} /></a>
  </div>
</section>

<script type="application/json" id="jobs-data" set:html={JSON.stringify(JOBS)} />
</SubLayout>

<style is:global>
  .job-item { display: flex; gap: 12px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid rgba(238,240,243,0.08); font-size: 15px; line-height: 1.5; }
</style>

<script>
  type Job = { accent: string; tagline: string; lead: string; items: string[]; price: string; priceLabel: string; note: string };
  const jobs: Job[] = JSON.parse(document.getElementById('jobs-data')!.textContent || '[]');
  const $ = (id: string) => document.getElementById(id)!;
  document.querySelectorAll<HTMLButtonElement>('[data-job]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const j = jobs[Number(btn.dataset.job)];
      document.querySelectorAll('[data-job]').forEach((b) => {
        b.classList.toggle('on', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      $('job-panel').style.borderTopColor = j.accent;
      $('job-tagline').textContent = j.tagline;
      $('job-lead').textContent = j.lead;
      $('job-price').textContent = j.price;
      $('job-label').textContent = j.priceLabel;
      $('job-note').textContent = j.note;
      $('job-items').replaceChildren(...j.items.map((label) => {
        const li = document.createElement('li');
        li.className = 'job-item';
        li.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="${j.accent}" stroke-width="2.4" aria-hidden="true" style="flex:none"><path d="M4 12.5l5 5L20 6.5"></path></svg>`;
        const s = document.createElement('span');
        s.textContent = label;
        li.append(s);
        return li;
      }));
      const body = $('job-body');
      body.classList.remove('swap');
      void body.offsetWidth;
      body.classList.add('swap');
    });
  });
</script>
