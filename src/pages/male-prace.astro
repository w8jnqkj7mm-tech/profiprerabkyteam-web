---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import { company } from '../config/company';

const title = 'Malé práce – Elektrikár, Vodár, Hodinový majster';
const description = 'Malé opravy a údržba: elektrikár, vodár, hodinový majster, klimatizácia. Rýchlo, spoľahlivo, od 50 €.';
---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- Hero section -->
  <section class="bg-bg-dark py-16 md:py-24 px-clamp-sm">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Malé práce</h1>
      <p class="text-text-secondary max-w-2xl text-lg">
        Nie všetko musí byť rekonštrukcia. Drobné opravy, údržba, menšie zmeny. Od 50 € + DPH bez dlhého čakania.
      </p>
    </div>
  </section>

  <!-- Services grid -->
  <section class="bg-bg-dark py-16 md:py-24 px-clamp-sm">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold mb-12">Čo všetko riešime</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <!-- Elektrikár -->
        <div class="rv bg-bg-panel border border-text-muted rounded-xl p-8 hover:border-brand-green transition-all">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-2xl font-bold mb-3">Elektrikár</h3>
          <ul class="space-y-2 text-text-secondary text-sm mb-6">
            <li>✓ Výmena zásuviek, vypínačov</li>
            <li>✓ Nové svetlá a lampy</li>
            <li>✓ Opravaelectrických spotrebičov</li>
            <li>✓ Revízia elektroinštalácie</li>
            <li>✓ Inštalácia zariadení</li>
          </ul>
          <p class="font-semibold text-text-primary">Od {company.contact.phone}</p>
        </div>

        <!-- Vodár -->
        <div class="rv bg-bg-panel border border-text-muted rounded-xl p-8 hover:border-brand-green transition-all">
          <div class="text-4xl mb-4">🔧</div>
          <h3 class="text-2xl font-bold mb-3">Vodár</h3>
          <ul class="space-y-2 text-text-secondary text-sm mb-6">
            <li>✓ Oprava tečúcich kohútikov</li>
            <li>✓ Výmena rúr a pripojení</li>
            <li>✓ Čistenie odpadov</li>
            <li>✓ Inštalácia radiátorov</li>
            <li>✓ Údržba vykurovania</li>
          </ul>
          <p class="font-semibold text-text-primary">Od {company.contact.phone}</p>
        </div>

        <!-- Hodinový majster -->
        <div class="rv bg-bg-panel border border-text-muted rounded-xl p-8 hover:border-brand-green transition-all">
          <div class="text-4xl mb-4">🔨</div>
          <h3 class="text-2xl font-bold mb-3">Hodinový majster</h3>
          <ul class="space-y-2 text-text-secondary text-sm mb-6">
            <li>✓ Výmena dlaždíc a doštičiek</li>
            <li>✓ Opravy podláh a dverí</li>
            <li>✓ Montáže a príslušenstvo</li>
            <li>✓ Menšie tesárske práce</li>
            <li>✓ Všetko, čo nie je na celý deň</li>
          </ul>
          <p class="font-semibold text-text-primary">Od {company.contact.phone}</p>
        </div>

        <!-- Klimatizácia -->
        <div class="rv bg-bg-panel border border-text-muted rounded-xl p-8 hover:border-brand-green transition-all">
          <div class="text-4xl mb-4">❄️</div>
          <h3 class="text-2xl font-bold mb-3">Klimatizácia</h3>
          <ul class="space-y-2 text-text-secondary text-sm mb-6">
            <li>✓ Montáž klimatizačných jednotiek</li>
            <li>✓ Predaj jednotiek aj B2B</li>
            <li>✓ Údržba a servis</li>
            <li>✓ Výmena chladiva</li>
            <li>✓ Poradenstvo na výber</li>
          </ul>
          <p class="font-semibold text-text-primary">Od 350 € + DPH</p>
        </div>
      </div>

      <!-- Process -->
      <div class="bg-bg-panel rounded-xl p-8 md:p-12 mb-16">
        <h3 class="text-2xl font-bold mb-8">Ako to funguje?</h3>
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-bg-dark font-bold text-sm">
              1
            </div>
            <div>
              <h4 class="font-semibold mb-1">Zavolaj alebo napíš</h4>
              <p class="text-text-secondary text-sm">Opíš, čo je potrebné opraviť. Veď máme všetko v jednotnom tíme.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-bg-dark font-bold text-sm">
              2
            </div>
            <div>
              <h4 class="font-semibold mb-1">Dohodneme čas</h4>
              <p class="text-text-secondary text-sm">Prídem na obhliadku a odčíťam, koľko to bude stať a ako dlho to potrvá.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-bg-dark font-bold text-sm">
              3
            </div>
            <div>
              <h4 class="font-semibold mb-1">Opravíme to</h4>
              <p class="text-text-secondary text-sm">Vykoná ho odborný remeselník. Všetko čisto a bez zbytočného ťahania.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-bg-dark font-bold text-sm">
              4
            </div>
            <div>
              <h4 class="font-semibold mb-1">Hotovo</h4>
              <p class="text-text-secondary text-sm">Zaplatíš len za skutočne vykonanú prácu. Bez skrytých poplatkov.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <p class="text-text-secondary mb-4">
          <strong>Pracovný čas:</strong> {company.contact.hoursLabel}
        </p>
        <a
          href={`tel:${company.contact.phone}`}
          class="btn inline-flex items-center gap-3 px-8 py-3 bg-brand-green text-bg-dark font-bold rounded-lg hover:bg-opacity-90 transition-all"
        >
          Zavolaj: {company.contact.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Contact form -->
  <ContactForm title="Napíšte nám o malej práci" description="Ak preferuješ formulár miesto volania, tu to máš." />

  <Footer />
</BaseLayout>

<style>
  .rv {
    animation: rv linear both;
    animation-timeline: view();
    animation-range: entry 5% cover 28%;
  }

  @keyframes rv {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
