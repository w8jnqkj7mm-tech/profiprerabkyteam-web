      <input id="chatin" type="text" autocomplete="off" placeholder="Napíšte, s čím potrebujete pomôcť…" style="flex:1;min-width:0;min-height:44px;padding:0 14px;background:rgba(13,18,21,0.5);border:1px solid rgba(238,240,243,0.16);border-radius:999px;color:#EEF0F3;font:400 14px Montserrat,sans-serif" />
      <button type="submit" aria-label="Odoslať správu" style={`width:44px;height:44px;flex:none;border-radius:50%;background:${BRAND};color:#0D1215;border:0;cursor:pointer;display:flex;align-items:center;justify-content:center`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
      </button>
    </form>
    <div style="border-top:1px solid rgba(238,240,243,0.1);padding:14px 18px">
      <a href="tel:+421948536398" style="display:flex;align-items:center;gap:10px;min-height:44px;font-size:14px;font-weight:600;color:#EEF0F3"><Fragment set:html={phoneIcon(16, BRAND)} /> Radšej voláte? +421 948 536 398</a>
      <span style="display:block;font-size:11px;line-height:1.5;color:rgba(238,240,243,0.45);margin-top:2px">Po–Pi 8:30–17:00 · odpovedáme do 4 hodín v pracovnom čase</span>
    </div>
  </div>

  <div style="display:flex;align-items:center;gap:10px">
    <a href="tel:+421948536398" class="btn" aria-label="Zavolajte nám na +421 948 536 398" style="width:56px;height:56px;padding:0;justify-content:center;border-radius:50%;background:#EEF0F3;color:#0D1215;box-shadow:0 8px 24px rgba(0,0,0,0.45)"><Fragment set:html={phoneIcon(22)} /></a>
    <button type="button" class="btn" id="chat-toggle" aria-expanded="false" style={`min-height:56px;padding:0 22px;background:${BRAND};color:#0D1215;border:0;font-weight:600;font-size:14px;box-shadow:0 8px 24px rgba(0,0,0,0.45)`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.3-.6L3 21l1.8-5.2A8.3 8.3 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5z"></path></svg>
      <span id="chat-toggle-label">S čím pomôžeme?</span>
    </button>
  </div>
</div>

</div>
</BaseLayout>


<script>
  import { TRADES, STEPS, JOBS, BRAND, answer } from '../data/home';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function restartSwap(el: HTMLElement) {
    el.classList.remove('swap');
    void el.offsetWidth;
    el.classList.add('swap');
  }

  // Intro
  const intro = document.getElementById('intro');
  if (intro) {
    const closeIntro = () => {
      try { localStorage.setItem('ppt-intro-v2', '1'); } catch {}
      intro.remove();
    };
    const v = $<HTMLVideoElement>('intro-video');
    v.muted = true;
    v.addEventListener('ended', closeIntro);
    v.play()?.catch(closeIntro);
    $('intro-skip').addEventListener('click', closeIntro);
  }

  // Hero slides
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  let slide = 0;
  if (!reduce) {
    setInterval(() => {
      slide = (slide + 1) % slides.length;
      slides.forEach((s, i) => (s.style.opacity = i === slide ? '1' : '0'));
    }, 6000);
  }

  // Menu
  const burger = $('burger');
  burger.addEventListener('click', () => {
    const open = $('navlinks').classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
  });

  // Small jobs
  document.querySelectorAll<HTMLButtonElement>('[data-job]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const j = JOBS[Number(btn.dataset.job)];
      document.querySelectorAll('[data-job]').forEach((b) => {
        b.classList.toggle('on', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      $('job-price').textContent = j.price;
      $('job-label').textContent = j.priceLabel;
      $('job-note').textContent = j.note;
      $('job-cta-text').textContent = j.cta;
      $<HTMLAnchorElement>('job-cta').href = j.href;
    });
  });

  // Main video
  $('replay-video').addEventListener('click', () => {
    const v = $<HTMLVideoElement>('main-video');
    v.currentTime = 0;
    v.muted = true;
    v.play()?.catch(() => {});
  });

  // Trades + before/after
  const range = $<HTMLInputElement>('ba');
  const setPos = (pos: number) => {
    $('ba-after').style.clipPath = `inset(0 0 0 ${pos}%)`;
    $('ba-handle').style.left = pos + '%';
  };
  range.addEventListener('input', () => setPos(Number(range.value)));

  document.querySelectorAll<HTMLButtonElement>('[data-trade]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const t = TRADES[Number(btn.dataset.trade)];
      document.querySelectorAll('[data-trade]').forEach((b) => {
        b.classList.toggle('on', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      $('trade-title').style.color = t.ink;
      $('trade-panel').style.borderTopColor = t.accent;
      const logo = $<HTMLImageElement>('trade-logo');
      logo.src = t.logo;
      logo.alt = t.brand;
      $('trade-tagline').textContent = t.tagline;
      const ul = $('trade-tasks');
      ul.replaceChildren(...t.tasks.map((label, j) => {
        const li = document.createElement('li');
        li.className = 'task';
        const n = document.createElement('span');
        n.className = 'task-n';
        n.style.color = t.ink;
        n.textContent = '0' + (j + 1);
        const l = document.createElement('span');
        l.textContent = label;
        li.append(n, l);
        return li;
      }));
      $('trade-shield').setAttribute('stroke', t.ink);
      $('trade-guarantee').textContent = t.guarantee;
      const link = $<HTMLAnchorElement>('trade-link');
      link.href = t.href;
      link.style.color = t.ink;
      $('trade-case').textContent = t.caseLabel;
      $<HTMLImageElement>('ba-before').src = t.before;
      $<HTMLImageElement>('ba-after-img').src = t.after;
      $('trade-place').textContent = t.place;
      range.value = '50';
      setPos(50);
      restartSwap($('trade-body'));
    });
  });

  // Steps
  let step = 0;
  let auto = true;
  const stepBtns = document.querySelectorAll<HTMLButtonElement>('[data-step]');
  const renderStep = () => {
    const s = STEPS[step];
    stepBtns.forEach((b, i) => {
      b.style.opacity = i <= step ? '1' : '0.38';
      b.setAttribute('aria-pressed', String(i === step));
    });
    $('steps-progress').style.width = ((step + 1) / 4) * 100 + '%';
    const num = $('step-num');
    num.textContent = '0' + (step + 1);
    num.style.color = s.ink;
    $('step-title').textContent = s.title;
    $('step-text').textContent = s.text;
    $('step-out').textContent = s.out;
    $('steps-play-label').textContent = auto ? 'Prehráva sa…' : 'Prehrať postup';
    restartSwap($('step-detail'));
  };
  stepBtns.forEach((b, i) => b.addEventListener('click', () => { step = i; auto = false; renderStep(); }));
  $('steps-play').addEventListener('click', () => { step = 0; auto = true; renderStep(); });
  if (reduce) { auto = false; $('steps-play-label').textContent = 'Prehrať postup'; }
  setInterval(() => { if (auto) { step = (step + 1) % 4; renderStep(); } }, 3400);

  // Lead form
  const leadValues = ['small_work', 'renovation'];
  document.querySelectorAll<HTMLButtonElement>('[data-lead]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-lead]').forEach((b) => {
        b.classList.toggle('on', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      $<HTMLInputElement>('lead-type').value = leadValues[Number(btn.dataset.lead)];
    });
  });
  $<HTMLFormElement>('lead-form').addEventListener('submit', (e) => {
    e.preventDefault();
    $('lead-sent').hidden = false;
  });

  // Assistant
  type Msg = { who: 'bot' | 'me'; text: string };
  const msgs: Msg[] = [{ who: 'bot', text: 'Dobrý deň. Som automatický asistent Profi Prerábky Team. Napíšte mi, s čím potrebujete pomôcť — alebo si vyberte z možností nižšie.' }];
  const pickedDays: string[] = [];
  const pickedSlots: string[] = [];
  let calOpen = false;

  const chat = $('chat');
  const chatInput = $<HTMLInputElement>('chatin');

  const pad = (n: number) => (n < 10 ? '0' + n : '' + n);
  const dayText = () => pickedDays.slice().sort().map((k) => {
    const p = k.split('-');
    return Number(p[2]) + '. ' + Number(p[1]) + '.';
  }).join(', ');

  function renderMsgs() {
    const box = $('chat-msgs');
    box.replaceChildren(...msgs.map((m) => {
      const wrap = document.createElement('div');
      wrap.style.cssText = 'display:flex;justify-content:' + (m.who === 'me' ? 'flex-end' : 'flex-start');
      const b = document.createElement('div');
      b.style.cssText = m.who === 'me'
        ? `max-width:84%;padding:10px 14px;border-radius:14px 14px 4px 14px;background:${BRAND};color:#0D1215;font-size:14px;line-height:1.5`
        : 'max-width:88%;padding:10px 14px;border-radius:14px 14px 14px 4px;background:rgba(13,18,21,0.55);box-shadow:inset 0 0 0 1px rgba(228,237,241,0.1);color:#EEF0F3;font-size:14px;line-height:1.55';
      b.textContent = m.text;
      wrap.append(b);
      return wrap;
    }));
    box.scrollTop = box.scrollHeight;
    $('chat-chips').hidden = msgs.length > 1;
    $('chat-actions').hidden = msgs.length < 3;
    updateWa();
  }

  function updateWa() {
    const lastMine = msgs.filter((m) => m.who === 'me').slice(-1)[0];
    const days = dayText();
    const text = 'Dobrý deň, píšem z webu. ' + (lastMine ? lastMine.text : 'Potrebujem poradiť.')
      + (pickedDays.length ? ' Termín by mi vyhovoval: ' + days + (pickedSlots.length ? ' (' + pickedSlots.join(', ') + ')' : '') + '.' : '');
    $<HTMLAnchorElement>('chat-wa').href = 'https://wa.me/421948536398?text=' + encodeURIComponent(text);
    const summary = $('cal-summary');
    summary.hidden = !(pickedDays.length || pickedSlots.length);
    summary.textContent = 'Vybrané: ' + (days || '—') + (pickedSlots.length ? ' · ' + pickedSlots.join(', ') : '');
  }

  function ask(text: string) {
    const q = text.trim();
    if (!q) return;
    msgs.push({ who: 'me', text: q }, { who: 'bot', text: answer(q) });
    chatInput.value = '';
    renderMsgs();
  }

  const calBase = 'font-family:Montserrat,sans-serif;min-height:34px;padding:0;border-radius:9px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid ';
  function renderCal() {
    const grid = $('cal-grid');
    const now = new Date();
    const first = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
    const lead = (first.getDay() + 6) % 7;
    const nodes: HTMLElement[] = ['Po', 'Ut', 'St', 'Št', 'Pi', 'So', 'Ne'].map((h) => {
      const s = document.createElement('span');
      s.style.cssText = 'text-align:center;font-size:10px;color:rgba(238,240,243,0.4);padding:2px 0';
      s.textContent = h;
      return s;
    });
    for (let i = 0; i < lead; i++) {
      const s = document.createElement('span');
      nodes.push(s);
    }
    for (let i = 0; i < 28; i++) {
      const d = new Date(first.getFullYear(), first.getMonth(), first.getDate() + i);
      const key = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
      const wd = d.getDay();
      const busy = wd === 0 || wd === 6 || d.getDate() % 7 === 3;
      const on = pickedDays.includes(key);
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = String(d.getDate());
      b.setAttribute('aria-label', d.getDate() + '. ' + (d.getMonth() + 1) + '. ' + (busy ? '— obsadené' : '— voľné'));
      if (busy) {
        b.disabled = true;
        b.style.cssText = calBase + 'transparent;background:transparent;color:rgba(238,240,243,0.22);cursor:not-allowed;text-decoration:line-through';
      } else {
        b.setAttribute('aria-pressed', String(on));
        b.style.cssText = on
          ? calBase + BRAND + ';background:' + BRAND + ';color:#0D1215'
          : calBase + 'rgba(238,240,243,0.18);background:transparent;color:rgba(238,240,243,0.85)';
        b.addEventListener('click', () => {
          const idx = pickedDays.indexOf(key);
          if (idx >= 0) pickedDays.splice(idx, 1); else pickedDays.push(key);
          renderCal();
          updateWa();
        });
      }
      nodes.push(b);
    }
    grid.replaceChildren(...nodes);

    $('cal-slots').replaceChildren(...['Doobeda 8:00–12:00', 'Poobede 12:00–17:00', 'Kedykoľvek'].map((label) => {
      const on = pickedSlots.includes(label);
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = label;
      b.setAttribute('aria-pressed', String(on));
      b.style.cssText = 'font-family:Montserrat,sans-serif;min-height:34px;padding:0 12px;border-radius:999px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid '
        + (on ? BRAND + ';background:' + BRAND + ';color:#0D1215' : 'rgba(238,240,243,0.18);background:transparent;color:rgba(238,240,243,0.8)');
      b.addEventListener('click', () => {
        const idx = pickedSlots.indexOf(label);
        if (idx >= 0) pickedSlots.splice(idx, 1); else pickedSlots.push(label);
        renderCal();
        updateWa();
      });
      return b;
    }));
  }

  const setChat = (open: boolean) => {
    chat.hidden = !open;
    $('chat-toggle').setAttribute('aria-expanded', String(open));
    $('chat-toggle-label').textContent = open ? 'Zavrieť' : 'S čím pomôžeme?';
  };
  $('chat-toggle').addEventListener('click', () => setChat(chat.hidden));
  $('chat-close').addEventListener('click', () => setChat(false));
  $('chat-to-form').addEventListener('click', () => setChat(false));
  document.querySelectorAll<HTMLButtonElement>('.chat-chip').forEach((c) => c.addEventListener('click', () => ask(c.textContent || '')));
  $<HTMLFormElement>('chat-form').addEventListener('submit', (e) => { e.preventDefault(); ask(chatInput.value); });
  $('cal-toggle').addEventListener('click', () => {
    calOpen = !calOpen;
    $('chat-cal').hidden = !calOpen;
    $('cal-toggle-label').textContent = calOpen ? 'Skryť kalendár' : 'Vybrať termín';
    if (calOpen) renderCal();
  });

  renderMsgs();
</script>
