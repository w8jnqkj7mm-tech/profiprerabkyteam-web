---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/site.css';
import { BRAND, TRADES, CREW, STEPS, JOBS, PRICES, SLIDES, CHIPS } from '../data/home';

const title = 'Profi Prerábky Team – Kompletné rekonštrukcie s vlastnými remeselníkmi';
const description = 'Kompletné rekonštrukcie bytov, domov a kancelárií v Bratislave. Prerábky, elektrikár, vodár a stolárstvo v jednom tíme.';

const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
const phoneIcon = (size: number, stroke = 'currentColor') => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="${stroke}" stroke-width="1.8" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>`;
const waIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.7-4.4-3.9-.1-.2-1-1.4-1-2.6 0-1.2.6-1.8.9-2.1.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.1.3.6 1.1 1.4 1.8 1 .9 1.8 1.1 2 1.2.3.1.4.1.6-.1l.8-1c.2-.2.4-.2.6-.1l1.8.9c.2.1.4.2.5.3 0 .1 0 .7-.2 1.3z"></path></svg>';
const playIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4l14 8-14 8z"></path></svg>';

const t0 = TRADES[0];
const s0 = STEPS[0];
const j0 = JOBS[0];
const marquee = Array.from({ length: 4 });
---

<BaseLayout title={title} description={description}>
<div class="home">

<!-- 0. INTRO -->
<div id="intro" role="dialog" aria-label="Úvodné video">
  <video id="intro-video" autoplay muted playsinline preload="auto" aria-label="Od pôdorysu po kľúč – Profi Prerábky Team">
    <source src="/media/intro-720.mp4" type="video/mp4" media="(max-width: 900px)" />
    <source src="/media/intro-1080.mp4" type="video/mp4" />
  </video>
  <button type="button" class="btn ghost" id="intro-skip" style="position:absolute;right:clamp(20px,5vw,48px);bottom:clamp(20px,5vw,48px);background:rgba(13,18,21,0.6)">
    Preskočiť intro <Fragment set:html={arrow} />
  </button>
</div>
<script is:inline>
  (function () {
    var el = document.getElementById('intro');
    var seen = false;
    try { seen = localStorage.getItem('ppt-intro-v2') === '1'; } catch (e) {}
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduce) el.remove();
  })();
</script>

<!-- 1. HERO -->
<section aria-label="Úvod" class="hero">
  <div aria-hidden="true" style="position:absolute;inset:0;overflow:hidden">
    {SLIDES.map((s, i) => (
      <div class="kb hero-slide" style={`position:absolute;inset:0;background:${s.bg};opacity:${i === 0 ? 1 : 0};transition:opacity 1.6s ease`}>
        {s.tag && <span style="position:absolute;right:20px;bottom:20px;font-size:11px;font-weight:600;letter-spacing:0.2em;color:rgba(238,240,243,0.5)">{s.tag}</span>}
      </div>
    ))}
  </div>
  <div aria-hidden="true" style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(20,32,40,0.72) 0%, rgba(20,32,40,0.18) 40%, rgba(15,25,32,0.94) 100%), linear-gradient(90deg, rgba(20,32,40,0.8) 0%, rgba(20,32,40,0) 62%)"></div>
  <div class="glow" aria-hidden="true" style="left:-8%;bottom:-14%;width:52%;height:70%;background:radial-gradient(circle at 40% 40%, rgba(81,174,75,0.30), rgba(81,174,75,0) 62%)"></div>
  <div class="glow" aria-hidden="true" style="right:-10%;top:-16%;width:46%;height:62%;background:radial-gradient(circle at 50% 50%, rgba(91,127,146,0.34), rgba(91,127,146,0) 64%)"></div>

  <header style="position:relative;z-index:3;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding:24px clamp(20px,5vw,72px)">
    <a href="/" aria-label="Profi Prerábky team – domov" style="display:flex;align-items:center">
      <img src="/logos/profi-prerabky-team-negativ.svg" alt="Profi Prerábky team" style="height:52px;width:auto" />
    </a>
    <button type="button" class="burger btn ghost" id="burger" aria-expanded="false" aria-label="Menu" style="min-height:44px;padding:0 16px;font-size:12px;letter-spacing:0.1em">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      MENU
    </button>
    <nav aria-label="Hlavná navigácia" class="navlinks" id="navlinks">
      <a href="/male-prace">Malé práce</a>
      <a href="/rekonstrukcie">Rekonštrukcie</a>
      <a href="#remesla">Remeslá</a>
      <a href="/cennik">Cenník</a>
      <a href="#postup">Postup</a>
      <a href="/realizacie">Realizácie</a>
      <a href="#dopyt">Kontakt</a>
    </nav>
  </header>

  <div id="hero" style="position:relative;z-index:2;flex:1;display:flex;flex-direction:column;justify-content:flex-end;padding:0 clamp(20px,5vw,72px) clamp(72px,10vh,120px);max-width:1320px">
    <div class="fade" style="display:inline-flex;align-self:flex-start;align-items:center;gap:10px;border:1px solid rgba(238,240,243,0.22);padding:9px 16px;font-size:12px;font-weight:500;letter-spacing:0.1em;margin-bottom:36px;background:rgba(13,18,21,0.4)">
      <span style={`width:6px;height:6px;background:${BRAND}`}></span>
      Bratislava a okolie · 4 špecializované remeslá v jednom tíme
    </div>
    <h1 style="margin:0;font-weight:600;font-size:min(10.2vw, clamp(40px,6.4vw,96px));line-height:1.02;letter-spacing:-0.025em">
      <span class="line l1"><span>Kompletné rekonštrukcie</span></span>
      <span class="line l2"><span>s vlastnými remeselníkmi.</span></span>
      <span class="line l3"><span class="dline" style={`color:${BRAND}`}>Od búrania po nábytok na mieru.</span></span>
    </h1>
    <div class="fade2" style="display:flex;flex-wrap:wrap;gap:14px;margin-top:44px">
      <a href="#dopyt" class="btn" style="min-height:52px;padding:0 28px;background:#EEF0F3;color:#0D1215;font-weight:600;font-size:14px;letter-spacing:0.06em">Nezáväzný dopyt <Fragment set:html={arrow} /></a>
      <a href="https://wa.me/421948536398" class="btn" style="min-height:52px;padding:0 24px;background:#25D366;color:#0D1215;font-weight:600;font-size:14px;letter-spacing:0.04em"><Fragment set:html={waIcon} /> WhatsApp</a>
      <a href="tel:+421948536398" class="btn" style="min-height:52px;padding:0 24px;border:1px solid rgba(238,240,243,0.35);color:#EEF0F3;font-weight:500;font-size:14px;letter-spacing:0.04em"><Fragment set:html={phoneIcon(16)} /> +421 948 536 398</a>
    </div>
  </div>

  <div class="scrollcue" aria-hidden="true">
    SCROLL
    <span style="display:block;width:1px;height:44px;background:rgba(238,240,243,0.15);position:relative;overflow:hidden"><span class="cue" style="position:absolute;inset:0;background:#EEF0F3"></span></span>
  </div>
</section>

<!-- 2. ROZCESTNÍK -->
<section aria-label="Čo potrebujete" style="padding:clamp(56px,7vw,88px) clamp(20px,5vw,72px);max-width:1320px;margin:0 auto">
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:20px">
    <div class="panel card" style={`display:flex;flex-direction:column;gap:20px;border-top:3px solid ${BRAND};padding:clamp(28px,3.4vw,44px)`}>
      <div>
        <div class="eyebrow" style={`color:${BRAND}`}>RÝCHLO A NA HODINY</div>
        <div style="font-size:clamp(26px,3vw,36px);font-weight:600;letter-spacing:-0.02em;margin-top:12px">Potrebujem malú prácu</div>
      </div>
      <div style="font-size:15px;line-height:1.65;color:rgba(238,240,243,0.7)">Vyberte, o čo ide — ukážeme cenu výjazdu. Zvyčajne termín do pár dní.</div>
      <div role="group" aria-label="Typ malej práce" style="display:flex;flex-wrap:wrap;gap:8px">
        {JOBS.map((j, i) => (
          <button type="button" class:list={['tab', 'chip', { on: i === 0 }]} data-job={i} aria-pressed={i === 0 ? 'true' : 'false'} style="min-height:44px;padding:0 14px;font-size:13px;font-weight:500">{j.label}</button>
        ))}
      </div>
      <div style="margin-top:auto;padding-top:20px;border-top:1px solid rgba(238,240,243,0.1)">
        <span style="display:block;font-size:24px;font-weight:600"><span id="job-price">{j0.price}</span> <span id="job-label" style="font-size:14px;font-weight:500;color:rgba(238,240,243,0.7)">{j0.priceLabel}</span></span>
        <span id="job-note" style="display:block;font-size:12px;line-height:1.6;color:rgba(238,240,243,0.5);margin-top:4px">{j0.note}</span>
        <span style="display:flex;flex-wrap:wrap;gap:16px;margin-top:14px;font-size:12px">
          <a href="/cennik" class="ulink">Celý cenník</a>
          <a href="/male-prace" class="ulink">Malé práce</a>
          <a href="/elektrikar" class="ulink">Elektrikár</a>
          <a href="/vodar" class="ulink">Vodár</a>
        </span>
        <a id="job-cta" href={j0.href} style={`display:inline-flex;align-items:center;gap:10px;margin-top:16px;min-height:44px;font-size:13px;font-weight:600;letter-spacing:0.1em;color:${BRAND}`}><span id="job-cta-text">{j0.cta}</span> <Fragment set:html={arrow} /></a>
      </div>
    </div>

    <a href="/rekonstrukcie" class="panel card" style="color:#EEF0F3;display:flex;flex-direction:column;gap:20px;border-top:3px solid #EEF0F3;padding:clamp(28px,3.4vw,44px)">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
        <div>
          <div class="eyebrow" style="color:rgba(238,240,243,0.75)">CELÝ PROJEKT NA KĽÚČ</div>
          <div style="font-size:clamp(26px,3vw,36px);font-weight:600;letter-spacing:-0.02em;margin-top:12px">Plánujem rekonštrukciu</div>
        </div>
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" style="flex:none;margin-top:6px"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </div>
      <div style="font-size:15px;line-height:1.65;color:rgba(238,240,243,0.7)">Byt, dom, kancelária alebo kúpeľňa. Jedna zmluva, jeden harmonogram, štyri remeslá z jedného tímu.</div>
      <div style="display:flex;flex-wrap:wrap;gap:8px">
        {['Byt', 'Dom', 'Kancelária', 'Kúpeľňa'].map((x) => <span class="pill">{x}</span>)}
      </div>
      <div style="margin-top:auto;padding-top:20px;border-top:1px solid rgba(238,240,243,0.1)">
        <span style="display:block;font-size:24px;font-weight:600">50 € <span style="font-size:14px;font-weight:500;color:rgba(238,240,243,0.7)">obhliadka v Bratislave</span></span>
        <span style="display:block;font-size:12px;color:rgba(238,240,243,0.5);margin-top:4px">61,50 € s DPH · pri realizácii sa celá odpočíta z ceny</span>
      </div>
    </a>
  </div>
</section>

<!-- 3. VIDEO -->
<section aria-label="Od pôdorysu po kľúč" style="padding:0 0 clamp(72px,9vw,120px)">
  <div style="max-width:1440px;margin:0 auto;padding:0 clamp(20px,5vw,72px)">
    <div class="rv" style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px">
      <h2 style="margin:0;font-weight:600;font-size:clamp(28px,3.6vw,48px);letter-spacing:-0.02em;line-height:1.1">Od pôdorysu <span class="dline" style={`color:${BRAND}`}>po kľúč.</span></h2>
      <button type="button" class="btn ghost" id="replay-video" style="min-height:48px;padding:0 22px"><Fragment set:html={playIcon} /> Prehrať znova</button>
    </div>
    <div class="panel" style="position:relative;overflow:hidden">
      <video id="main-video" poster="/media/intro-poster.jpg" muted playsinline preload="metadata" aria-label="3D animácia: od pôdorysu po odovzdanie na kľúč" style="width:100%;height:auto;display:block">
        <source src="/media/intro-720.mp4" type="video/mp4" media="(max-width: 900px)" />
        <source src="/media/intro-1080.mp4" type="video/mp4" />
      </video>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:18px;font-size:12px;letter-spacing:0.08em;color:rgba(238,240,243,0.6)">
      {['Navrhneme', 'Postavíme', 'Rozvedieme', 'Omietneme', 'Zariadime na mieru', 'Odovzdáme na kľúč'].map((x, i, a) => (
        <Fragment><span>{x}</span>{i < a.length - 1 && <span aria-hidden="true" style={`color:${BRAND}`}>·</span>}</Fragment>
      ))}
    </div>
  </div>
</section>

<!-- 4. MARQUEE -->
<div aria-hidden="true" style="border-top:1px solid rgba(238,240,243,0.1);border-bottom:1px solid rgba(238,240,243,0.1);padding:22px 0;overflow:hidden">
  <div class="track" style="font-family:Spectral,Georgia,serif;font-size:34px;gap:48px;white-space:nowrap;color:rgba(238,240,243,0.85)">
    {marquee.map(() => (
      <Fragment>
        <span>Prerábky</span><span style={`color:${BRAND}`}>✕</span>
        <span style="font-style:italic">Elektrikár</span><span style={`color:${BRAND}`}>✕</span>
        <span>Vodár</span><span style={`color:${BRAND}`}>✕</span>
        <span style="font-style:italic">Stolárstvo</span><span style={`color:${BRAND}`}>✕</span>
      </Fragment>
    ))}
  </div>
</div>

<!-- 5. STATEMENT -->
<section style="padding:clamp(96px,14vw,180px) clamp(20px,5vw,72px);max-width:1320px;margin:0 auto">
  <p class="rv kicker" style={`margin:0 0 28px;color:${BRAND}`}>PREČO JEDEN TÍM</p>
  <h2 class="rv" style="margin:0;font-weight:500;font-size:clamp(32px,4.6vw,68px);line-height:1.12;letter-spacing:-0.02em;max-width:1100px">Jedna zmluva. Jeden harmonogram. <span class="dline" style="color:rgba(238,240,243,0.6)">Štyri remeslá, ktoré sa na stavbe nečakajú navzájom.</span></h2>
  <div class="rv" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:40px;margin-top:72px;border-top:1px solid rgba(238,240,243,0.12);padding-top:36px">
    <div><div class="pillar-t">Vlastní ľudia</div><div class="pillar-d">Murári, elektrikári, vodári aj stolári sú z jedného tímu. Žiadne preposielanie práce ďalej.</div></div>
    <div><div class="pillar-t">Jeden zodpovedný majster</div><div class="pillar-d">Vy voláte jednému človeku. On rieši poradie remesiel, materiál aj termíny.</div></div>
    <div><div class="pillar-t">Nadväznosť bez prestojov</div><div class="pillar-d">Rozvody, povrchy a nábytok plánujeme spolu, takže stolár dostane presne tie rozmery, ktoré murár postavil.</div></div>
  </div>
</section>

<!-- 6. REMESLÁ -->
<section id="remesla" style="padding:0 clamp(20px,5vw,72px) clamp(96px,12vw,160px);max-width:1440px;margin:0 auto">
  <div class="rv" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:48px">
    <h2 style="margin:0;font-weight:600;font-size:clamp(36px,5vw,72px);letter-spacing:-0.025em;line-height:1">Štyri remeslá.<br /><span id="trade-title" class="dline" style={`color:${t0.ink};transition:color .5s`}>Jeden tím.</span></h2>
    <p style="margin:0;max-width:380px;font-size:15px;line-height:1.65;color:rgba(238,240,243,0.65)">Vyberte remeslo a posuňte jazdec Pred / Po.</p>
  </div>

  <div style="display:flex;flex-wrap:wrap;gap:20px;align-items:stretch">
    <div role="group" aria-label="Výber remesla" style="flex:1 1 280px;display:flex;flex-direction:column;gap:10px">
      {TRADES.map((tr, i) => (
        <button type="button" class:list={['tab', 'trade-tab', { on: i === 0 }]} data-trade={i} aria-pressed={i === 0 ? 'true' : 'false'} style={`--accent:${tr.accent}`}>
          <span style="font-size:12px;font-weight:600;letter-spacing:0.1em;opacity:0.7">0{i + 1}</span>
          <span style="flex:1">
            <span style="display:block;font-size:20px;font-weight:600;letter-spacing:-0.01em">{tr.name}</span>
            <span style="display:block;font-size:12px;letter-spacing:0.08em;margin-top:4px;opacity:0.7">{tr.brand}</span>
          </span>
          <span class="dot" style="width:10px;height:10px;flex:none"></span>
        </button>
      ))}
    </div>

    <div style="flex:999 1 640px;min-width:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:20px">
      <div class="panel" id="trade-panel" style={`border-top:3px solid ${t0.accent};padding:36px;display:flex;flex-direction:column;gap:26px;transition:border-color .5s`}>
        <div id="trade-body" class="swap" style="display:flex;flex-direction:column;gap:26px">
          <div>
            <img id="trade-logo" src={t0.logo} alt={t0.brand} style="height:64px;width:auto" />
            <div id="trade-tagline" class="dline" style="font-style:normal;font-size:30px;line-height:1.2;margin-top:12px">{t0.tagline}</div>
          </div>
          <ul id="trade-tasks" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column">
            {t0.tasks.map((k, j) => (
              <li class="task"><span class="task-n" style={`color:${t0.ink}`}>0{j + 1}</span><span class="task-l">{k}</span></li>
            ))}
          </ul>
          <div style="display:flex;gap:14px;align-items:flex-start;padding:16px 18px;background:rgba(238,240,243,0.04)">
            <svg id="trade-shield" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={t0.ink} stroke-width="1.8" aria-hidden="true" style="flex:none;margin-top:2px"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path><path d="M8.5 12l2.5 2.5 4.5-5"></path></svg>
            <div id="trade-guarantee" style="font-size:14px;line-height:1.6;color:rgba(238,240,243,0.82)">{t0.guarantee}</div>
          </div>
          <a id="trade-link" href={t0.href} style={`display:inline-flex;align-items:center;gap:10px;font-size:13px;font-weight:600;letter-spacing:0.1em;color:${t0.ink};min-height:44px`}>PODROBNE O REMESLE <Fragment set:html={arrow} /></a>
        </div>
      </div>

      <div id="realizacie" style="display:flex;flex-direction:column;gap:14px">
        <div class="panel" style="position:relative;flex:1;min-height:440px;overflow:hidden;background:#1a1918">
          <img id="ba-before" src={t0.before} alt="" aria-hidden="true" class="ba-img" />
          <div aria-hidden="true" class="ba-tag" style="left:20px">PRED</div>
          <div aria-hidden="true" id="ba-after" style="position:absolute;inset:0;clip-path:inset(0 0 0 50%)">
            <img id="ba-after-img" src={t0.after} alt="" class="ba-img" />
            <div class="ba-tag" style="right:20px">PO</div>
          </div>
          <div aria-hidden="true" id="ba-handle" style="position:absolute;top:0;bottom:0;left:50%;width:2px;background:#EEF0F3;transform:translateX(-1px);pointer-events:none">
            <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;background:#EEF0F3;color:#0D1215;display:flex;align-items:center;justify-content:center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6"></path></svg>
            </div>
          </div>
          <label for="ba" class="sr-only">Porovnanie pred a po</label>
          <input id="ba" class="range" type="range" min="0" max="100" value="50" />
        </div>
        <div style="display:flex;justify-content:space-between;gap:12px;font-size:13px;color:rgba(238,240,243,0.6)">
          <span id="trade-case">{t0.caseLabel}</span><span id="trade-place">{t0.place}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 7. CENY A ZÁRUKA -->
