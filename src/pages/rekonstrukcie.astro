---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';

const title = 'Rekonštrukcie – Byt, dom, kúpeľňa, kancelária';
const description = 'Kompletné rekonštrukcie od plánu do odevzdania. Elektrikár, vodár, stavebník, stolár – všetko v jednom tíme.';

const projectTypes = [
  {
    title: 'Byt',
    description: 'Kompletná obnova jednostranky až veľkého 4-izbového bytu. S novým nábytkom na mieru.',
    icon: '🏢',
  },
  {
    title: 'Dom',
    description: 'Rekonštrukcia rodinného domu, jednotlivých miestností alebo rozšírenie objektu.',
    icon: '🏠',
  },
  {
    title: 'Kúpeľňa',
    description: 'Špecializácia na kúpeľne – od plánu po nové obklady, vykurovanie, svetlá.',
    icon: '🚿',
  },
  {
    title: 'Kuchyňa',
    description: 'Nová kuchyňa so skrytou elektrickým spotrebičmi a majster-postavený nábytok.',
    icon: '🍳',
  },
  {
    title: 'Kancelária',
    description: 'Prestavba komerčného priestoru s ohľadom na bezpečnosť a požiadavky zákona.',
    icon: '🏢',
  },
  {
    title: 'Ostatné',
    description: 'Tvarové a iné špecifické projektov. Vždy nájdeme riešenie.',
    icon: '🔧',
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- Hero section -->
  <section class="bg-bg-dark py-16 md:py-24 px-clamp-sm">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Rekonštrukcie</h1>
      <p class="text-text-secondary max-w-2xl text-lg">
        Od prvého stretnutia cez projekt po odovzdanie na kľúč. Všetko remeslo v jednom tíme – bez koordinácie externe.
      </p>
    </div>
  </section>

  <!-- Project types -->
  <section class="bg-bg-dark py-16 md:py-24 px-clamp-sm">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold mb-12">Aké projekty riešime?</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {projectTypes.map((type) => (
          <div class="rv bg-bg-panel border border-text-muted rounded-xl p-8 hover:border-brand-green transition-all">
            <div class="text-5xl mb-4">{type.icon}</div>
            <h3 class="text-xl font-bold mb-2">{type.title}</h3>
            <p class="text-text-secondary text-sm">{type.description}</p>
          </div>
        ))}
      </div>

      <!-- Why choose us -->
      <div class="bg-bg-panel rounded-xl p-8 md:p-12 mb-16">
        <h3 class="text-2xl font-bold mb-8">Prečo sa nám oplatí?</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h4 class="font-bold text-lg mb-2 text-brand-green">Všetko v jednom</h4>
            <p class="text-text-secondary text-sm">
              Bez čakania na externý tím. Elektrikár a vodár vedia, ako spolu pracovať. Stolár pristúpi, keď sú steny hotové.
            </p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2 text-brand-green">Jeden manažér</h4>
            <p class="text-text-secondary text-sm">
              Vždy vieš, kto rozhoduje. Jeden z dvojice (Števo alebo Jakub) si vezme tvoj projekt za svoj.
            </p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2 text-brand-green">Lacnejšie</h4>
            <p class="text-text-secondary text-sm">
              Bez medziinštitúcií a sprostredkovateľov. Nákup materiálu riešime sami. Cena je nižšia.
            </p>
          </div>
          <div>
            <h4 class="font-bold text-lg mb-2 text-brand-green">Rýchlejšie</h4>
            <p class="text-text-secondary text-sm">
              Bez zbytočného čakania. Keď je čas, všetci vedia, čo sa deje. Práce na sebe navzájom nadväzujú.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <ProcessTimeline />

  <!-- Warranty -->
  <section class="bg-bg-panel py-16 md:py-24 px-clamp-sm">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">Záruka na naše práce</h2>
      <div class="space-y-4 text-left max-w-2xl mx-auto">
        <div class="bg-bg-dark rounded-lg p-6">
          <h3 class="font-bold text-lg mb-2">2 roky záruka</h3>
          <p class="text-text-secondary text-sm">
            Na všetky práce – elektrikárstvo, vodoinstalácii, stavebné práce, nábytok.
          </p>
        </div>
        <div class="bg-bg-dark rounded-lg p-6">
          <h3 class="font-bold text-lg mb-2">10 rokov záruka na obklady a dlažby</h3>
          <p class="text-text-secondary text-sm">
            Podmienka: Produkty Sopro a stavba na pevnom, stabilnom podklade.
          </p>
          <p class="text-text-secondary text-xs mt-2 italic">
            Neplatí pri provizórnych riešeniach, ktoré si vyžiadal zákazník.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact form -->
  <ContactForm
    title="Bezplatná obhliadka a návrh"
    description="Nepredajom ti nič bez poriadneho návrhu. Prídem, pozriem si to, a do týždňa máš odhad."
  />

  <Footer />
</BaseLayout>

<style>
  .rv {
    animation: rv linear both;
    animation-timeline: view();
    animation-range: entry 5% cover 28%;
  }

  @keyframes rv {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
