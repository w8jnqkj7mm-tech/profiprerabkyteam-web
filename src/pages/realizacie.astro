---
import SubLayout from '../layouts/SubLayout.astro';
import { BRAND, CREW } from '../data/home';
import { PROJECTS, FILTERS } from '../data/realizacie';

const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
---

<SubLayout title="Realizácie – Profi Prerábky Team" description="Rekonštrukcie, kúpeľne, kuchyne a nábytok na mieru v Bratislave. Fotky pred a po z našich zákaziek." current="/realizacie">

<section class="sub-wrap" style="padding-block:clamp(56px,7vw,96px) clamp(32px,4vw,48px)">
  <nav class="crumbs" aria-label="Omrvinky"><a href="/">Úvod</a> · Realizácie</nav>
  <h1 class="sub-h1">Realizácie.<br /><span class="dline" style={`color:${BRAND}`}>Pred a po, bez prikrášľovania.</span></h1>
  <p class="sub-lead">Fotky zverejňujeme so súhlasom klientov. Bez mien a bez adries — uvádzame len typ práce a mestskú časť.</p>

  <div role="group" aria-label="Filter realizácií" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:36px">
    {FILTERS.map((f, i) => (
      <button type="button" class:list={['tab', 'chip', 'pill-tab', { on: i === 0 }]} data-cat={f.cat ?? ''} aria-pressed={i === 0 ? 'true' : 'false'} style="min-height:44px;padding:0 20px;font-size:13px;font-weight:600;border-radius:999px">{f.label}</button>
    ))}
  </div>
  <p id="real-count" style="margin:18px 0 0;font-size:13px;color:rgba(238,240,243,0.5)">Zobrazených {PROJECTS.length} z {PROJECTS.length} realizácií</p>
</section>

<section class="sub-wrap" style="padding-bottom:clamp(64px,8vw,104px)">
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(320px,100%),1fr));gap:24px">
    {PROJECTS.map((p) => (
      <article class="panel card real-card" data-cat={p.cat} style="border-radius:16px;overflow:hidden;display:flex;flex-direction:column">
        <div style="position:relative;height:260px;overflow:hidden;display:flex;background:#1a1918">
          {p.before ? (
            <Fragment>
              <div class="real-half"><img src={p.before} alt={`${p.title} – pred`} loading="lazy" /><span class="real-tag" style="left:12px">PRED</span></div>
              <div class="real-half"><img src={p.after} alt={`${p.title} – po`} loading="lazy" /><span class="real-tag" style="right:12px">PO</span></div>
              <span aria-hidden="true" style="position:absolute;top:0;bottom:0;left:50%;width:2px;background:#EEF0F3"></span>
            </Fragment>
          ) : (
            <div class="real-half"><img src={p.after} alt={p.title} loading="lazy" /><span class="real-tag" style="right:12px">HOTOVO</span></div>
          )}
        </div>
        <div style="padding:26px;display:flex;flex-direction:column;gap:12px;flex:1">
          <span style={`font-size:11px;font-weight:600;letter-spacing:0.2em;color:${p.ink}`}>{p.tag}</span>
          <h2 style="margin:0;font-size:20px;font-weight:600;line-height:1.25">{p.title}</h2>
          <p style="margin:0;font-size:14px;line-height:1.65;color:rgba(238,240,243,0.68)">{p.text}</p>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px">
            {p.crew.map((c) => <span style={`font-size:11px;font-weight:600;letter-spacing:0.06em;padding:5px 9px;color:#EEF0F3;background:${CREW[c].bg}`}>{CREW[c].name}</span>)}
          </div>
          <div style="margin-top:auto;padding-top:16px;border-top:1px solid rgba(238,240,243,0.1);font-size:12px;letter-spacing:0.06em;color:rgba(238,240,243,0.5)">{p.place}</div>
        </div>
      </article>
    ))}
  </div>
</section>

<section class="light-band" style="padding:clamp(64px,8vw,104px) 0">
  <div class="sub-wrap">
    <p class="kicker" style="margin:0 0 18px;color:#2F4858">HODNOTENIA</p>
    <h2 style="margin:0 0 40px;font-weight:600;font-size:clamp(28px,3.8vw,48px);letter-spacing:-0.02em;line-height:1.1;color:#0D1215">Čo o nás píšu <span class="dline">na Google.</span></h2>
    <div style="background:linear-gradient(180deg,#ffffff 0%,#f3f7f9 100%);border-radius:16px;box-shadow:0 18px 40px rgba(26,45,56,0.14);border:1px dashed rgba(13,18,21,0.25);padding:48px;text-align:center">
      <p style="margin:0 0 10px;font-size:12px;letter-spacing:0.2em;color:#5a6b77">[WIDGET GOOGLE RECENZIÍ]</p>
      <p style="margin:0 auto;font-size:14px;line-height:1.7;color:#2F4858;max-width:560px">Načítané cez Google Places API pre všetky štyri firmy — hodnotenie, počet recenzií a odkaz na profil. Recenzie sa neprepisujú ručne.</p>
    </div>
  </div>
</section>

<section class="sub-wrap" style="padding-block:clamp(64px,8vw,104px)">
  <div class="panel" style={`border-radius:16px;border-left:3px solid ${BRAND};padding:clamp(32px,4vw,56px);display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between`}>
    <div>
      <h2 style="margin:0;font-weight:600;font-size:clamp(26px,3.2vw,40px);letter-spacing:-0.02em;line-height:1.1">Chcete podobnú <span class="dline" style={`color:${BRAND}`}>u vás?</span></h2>
      <p style="margin:16px 0 0;font-size:15px;line-height:1.7;color:rgba(238,240,243,0.7);max-width:480px">Dohodneme obhliadku a pripravíme cenovú ponuku podľa skutočného stavu.</p>
    </div>
    <a href="/#dopyt" class="btn" style={`min-height:54px;padding:0 30px;background:${BRAND};color:#0D1215;font-weight:700;font-size:14px;letter-spacing:0.06em`}>Nezáväzný dopyt <Fragment set:html={arrow} /></a>
  </div>
</section>

</SubLayout>

<style is:global>
  .real-half { position: relative; flex: 1 1 0; min-width: 0; }
  .real-half img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .real-tag { position: absolute; bottom: 12px; font-size: 10px; font-weight: 600; letter-spacing: 0.2em; background: rgba(13,18,21,0.7); padding: 5px 9px; }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.real-card');
  const count = document.getElementById('real-count')!;
  document.querySelectorAll<HTMLButtonElement>('[data-cat].pill-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.pill-tab').forEach((b) => {
        b.classList.toggle('on', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      const cat = btn.dataset.cat;
      let shown = 0;
      cards.forEach((c) => {
        const vis = !cat || c.dataset.cat === cat;
        c.hidden = !vis;
        if (vis) shown++;
      });
      count.textContent = `Zobrazených ${shown} z ${cards.length} realizácií`;
    });
  });
</script>
