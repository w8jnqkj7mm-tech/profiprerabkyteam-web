---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Realizácie – Profi Prerábky Team';
const description = 'Projekty, ktoré sme postavili: byty, domy, kúpeľne. Všetko od plánu po odevzdanie na kľúč.';

// TODO: Načítať fotky z databázy alebo statického JSON
const projects = [
  {
    id: 1,
    title: 'Palisády – Kuchyňa',
    location: 'Palisády',
    type: 'kitchen',
    trades: ['Profi Prerábky', 'Elektrikár', 'Vodár', 'Stolárstvo'],
    duration: '4 týždne',
    beforeImage: '[FOTKA - PRED]',
    afterImage: '[FOTKA - PO]',
    description: 'Kompletná rekonštrukcia kuchyne so zatepľovaním a novými rozvody.',
  },
  {
    id: 2,
    title: 'Ružinov – Kúpeľňa',
    location: 'Ružinov',
    type: 'bathroom',
    trades: ['Profi Prerábky', 'Elektrikár', 'Vodár'],
    duration: '2 týždne',
    beforeImage: '[FOTKA - PRED]',
    afterImage: '[FOTKA - PO]',
    description: 'Rekonštrukcia kúpeľne, nové obklady a zariadenie.',
  },
  {
    id: 3,
    title: 'Ružinov – Obývačka',
    location: 'Ružinov',
    type: 'renovation',
    trades: ['Profi Prerábky', 'Elektrikár', 'Vodár', 'Stolárstvo'],
    duration: '6 týždňov',
    beforeImage: '[FOTKA - PRED]',
    afterImage: '[FOTKA - PO]',
    description: 'Kompletná obnova obývačky s novým nábytkom na mieru.',
  },
];

const typeLabels = {
  kitchen: 'Kuchyňa',
  bathroom: 'Kúpeľňa',
  bedroom: 'Spálňa',
  renovation: 'Kompletná rekonštrukcia',
  commercial: 'Komerčný priestor',
};
---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- Hero section -->
  <section class="bg-bg-dark py-16 md:py-24 px-clamp-sm">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Naše realizácie</h1>
      <p class="text-text-secondary max-w-2xl text-lg">
        Projekty, ktoré sme postavili v Bratislave a okolí. Všetko od prvého telefónu cez plán až po odevzdanie na kľúč.
      </p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="bg-bg-dark py-16 md:py-24 px-clamp-sm">
    <div class="max-w-7xl mx-auto">
      <!-- Filter buttons (future) -->
      <div class="mb-12 flex flex-wrap gap-3">
        <button class="active px-6 py-2 rounded-lg bg-brand-green text-bg-dark font-semibold text-sm transition-all hover:bg-opacity-90">
          Všetky
        </button>
        <button class="px-6 py-2 rounded-lg border border-text-muted text-text-secondary font-semibold text-sm hover:border-brand-green transition-all">
          Kuchyne
        </button>
        <button class="px-6 py-2 rounded-lg border border-text-muted text-text-secondary font-semibold text-sm hover:border-brand-green transition-all">
          Kúpeľne
        </button>
        <button class="px-6 py-2 rounded-lg border border-text-muted text-text-secondary font-semibold text-sm hover:border-brand-green transition-all">
          Kompletné rekonštrukcie
        </button>
      </div>

      <!-- Projects grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project) => (
          <div class="rv group bg-bg-panel border border-text-muted rounded-xl overflow-hidden hover:border-brand-green transition-all duration-350">
            <!-- Image comparison wrapper -->
            <div class="relative h-64 bg-bg-dark overflow-hidden group-hover:shadow-lg transition-shadow">
              <!-- Placeholder for before/after slider (TODO: implement with JS) -->
              <div class="absolute inset-0 flex items-center justify-center text-text-secondary">
                <div class="text-center">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="mx-auto mb-2 opacity-50">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                  <p class="text-xs">Pred / Po fotky</p>
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <div class="flex flex-wrap gap-2 mb-3">
                <span class="px-2 py-1 bg-bg-dark rounded text-xs font-medium text-text-secondary">
                  {typeLabels[project.type] || project.type}
                </span>
                <span class="px-2 py-1 bg-bg-dark rounded text-xs font-medium text-text-secondary">
                  {project.duration}
                </span>
              </div>

              <h3 class="font-bold text-lg mb-1 group-hover:text-brand-green transition-colors">{project.title}</h3>
              <p class="text-text-secondary text-sm mb-4">{project.location}</p>

              <p class="text-sm text-text-secondary mb-4 line-clamp-2">{project.description}</p>

              <!-- Trades used -->
              <div class="flex flex-wrap gap-1.5 mb-4">
                {project.trades.map((trade) => (
                  <span class="px-2 py-0.5 bg-brand-green/10 text-brand-green text-xs font-medium rounded">
                    {trade}
                  </span>
                ))}
              </div>

              <a href="#" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-green hover:gap-3 transition-all">
                Pozri viac
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-20 text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Máš svoj projekt?</h2>
        <p class="text-text-secondary mb-8 max-w-xl mx-auto">
          Aj to sa môže vyskytnúť. Nezáväzný dopyt a do 4 hodín ti povieme, či vieme pomôcť.
        </p>
        <a
          href="/#dopyt"
          class="btn inline-flex items-center gap-3 px-8 py-3 bg-brand-green text-bg-dark font-bold rounded-lg hover:bg-opacity-90 transition-all"
        >
          Nezáväzný dopyt
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .active {
    background-color: #51ae4b !important;
    color: #0d1215 !important;
  }

  .rv {
    animation: rv linear both;
    animation-timeline: view();
    animation-range: entry 5% cover 28%;
  }

  @keyframes rv {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
