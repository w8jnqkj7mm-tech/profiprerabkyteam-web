---
import SubLayout from '../../layouts/SubLayout.astro';

interface Props { doc: 'gdpr' | 'cookies' }
const { doc } = Astro.props;
const DOCS = {
  gdpr: { href: '/gdpr', label: 'Ochrana osobných údajov', title: 'Ochrana osobných údajov' },
  cookies: { href: '/cookies', label: 'Cookies', title: 'Zásady používania cookies' },
};
const d = DOCS[doc];
---
<SubLayout title={`${d.title} – Profi Prerábky Team`} description={`${d.title} na webe profiprerabkyteam.sk.`}>
<section style="padding:clamp(48px,6vw,80px) clamp(20px,5vw,64px) clamp(24px,3vw,40px);max-width:900px;margin:0 auto">
  <nav class="crumbs" aria-label="Omrvinky" style="margin-bottom:24px"><a href="/">Úvod</a> · {d.label}</nav>
  <nav aria-label="Výber dokumentu" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px">
    {Object.entries(DOCS).map(([k, x]) => (
      <a href={x.href} class:list={['tab', 'chip', { on: k === doc }]} aria-current={k === doc ? 'page' : undefined} style="display:inline-flex;align-items:center;min-height:44px;padding:0 20px;font-size:13px;font-weight:600;border-radius:999px">{x.label}</a>
    ))}
  </nav>
  <h1 style="margin:0;font-weight:600;font-size:clamp(30px,4.4vw,52px);line-height:1.1;letter-spacing:-0.025em">{d.title}</h1>
  <p style="margin:18px 0 0;font-size:14px;color:rgba(238,240,243,0.55)">Účinné od [DÁTUM ÚČINNOSTI] · Posledná aktualizácia [DÁTUM]</p>
  <p style="margin:20px 0 0;font-size:13px;line-height:1.7;color:#FFC65C;background:rgba(255,198,92,0.1);border-left:2px solid #FFC65C;border-radius:0 12px 12px 0;padding:14px 18px">Toto je návrh štruktúry, nie právny text. Pred spustením musí prejsť kontrolou — žltým sú označené miesta, ktoré treba doplniť alebo overiť.</p>
</section>
<section class="doc" style="padding:0 clamp(20px,5vw,64px) clamp(64px,8vw,104px);max-width:900px;margin:0 auto">
  <slot />
  <div style="margin-top:48px;padding-top:28px;border-top:1px solid rgba(238,240,243,0.12);display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;align-items:center">
    <p style="margin:0;font-size:14px;color:rgba(238,240,243,0.6)">Máte otázku k spracúvaniu údajov?</p>
    <a href="/kontakt" class="btn" style="min-height:48px;padding:0 24px;border:1px solid rgba(238,240,243,0.3);color:#EEF0F3;font-weight:600;font-size:13px;letter-spacing:0.06em">Napísať nám</a>
  </div>
</section>
</SubLayout>
