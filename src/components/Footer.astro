---
import { company } from '../config/company';
---

<footer class="bg-bg-panel border-t border-text-muted">
  <div class="max-w-7xl mx-auto px-clamp-sm py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider mb-6 text-text-primary">Profi Prerábky</h3>
        <p class="text-xs text-text-secondary leading-relaxed mb-4">Kompletné rekonštrukcie s vlastnými remeselníkmi v Bratislave a okolí.</p>
        <div class="flex gap-3">
          <a href={`https://instagram.com/${company.social.instagram}`} target="_blank" rel="noopener" class="p-2 hover:bg-bg-dark rounded transition-colors" aria-label="Instagram">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5z"/><circle cx="12" cy="12" r="3" fill="#0D1215"/><circle cx="18" cy="6" r="1" fill="#0D1215"/>
            </svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener" class="p-2 hover:bg-bg-dark rounded transition-colors" aria-label="Facebook">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider mb-6 text-text-primary">Navigácia</h3>
        <nav class="space-y-3 text-xs">
          <a href="/male-prace" class="text-text-secondary hover:text-brand-green transition-colors block">Malé práce</a>
          <a href="/rekonstrukcie" class="text-text-secondary hover:text-brand-green transition-colors block">Rekonštrukcie</a>
          <a href="/realizacie" class="text-text-secondary hover:text-brand-green transition-colors block">Realizácie</a>
          <a href="/cennik" class="text-text-secondary hover:text-brand-green transition-colors block">Cenník</a>
          <a href="/blog" class="text-text-secondary hover:text-brand-green transition-colors block">Blog</a>
        </nav>
      </div>

      <!-- Remeslá -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider mb-6 text-text-primary">Remeslá</h3>
        <nav class="space-y-3 text-xs">
          <a href="/elektrikar" class="text-text-secondary hover:text-brand-green transition-colors block">Pán Elektrikár</a>
          <a href="/vodar" class="text-text-secondary hover:text-brand-green transition-colors block">Pán Vodár</a>
          <a href="/prerabky" class="text-text-secondary hover:text-brand-green transition-colors block">Komplexné prerábky</a>
          <a href="/stolarstvo" class="text-text-secondary hover:text-brand-green transition-colors block">Stolárstvo Pressburg</a>
        </nav>
      </div>

      <!-- Právne a Kontakt -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider mb-6 text-text-primary">Právne</h3>
        <nav class="space-y-3 text-xs mb-8">
          <a href="/gdpr" class="text-text-secondary hover:text-brand-green transition-colors block">GDPR</a>
          <a href="/cookies" class="text-text-secondary hover:text-brand-green transition-colors block">Cookies</a>
          <a href="/kontakt" class="text-text-secondary hover:text-brand-green transition-colors block">Kontakt</a>
        </nav>
      </div>
    </div>

    <!-- Divider -->
    <hr class="border-text-muted my-12" />

    <!-- Company Info & Copyright -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-xs text-text-secondary">
      <div>
        <p class="font-semibold text-text-primary mb-2">{company.operator.name}</p>
        <p>IČO: {company.operator.ico}</p>
        <p>{company.operator.address}</p>
        <p class="mt-2 text-text-muted">{company.operator.registerInfo}</p>
      </div>
      <div class="text-right md:text-left">
        <p class="mb-3">
          <strong>Kontakt:</strong><br />
          <a href={`mailto:${company.contact.email}`} class="hover:text-brand-green transition-colors">{company.contact.email}</a><br />
          <a href={`tel:${company.contact.phone}`} class="hover:text-brand-green transition-colors">{company.contact.phone}</a><br />
          Pracovný čas: {company.contact.hoursLabel}
        </p>
        <p class="text-text-muted">© 2026 Profi Prerábky Team. Všetky práva vyhradené.</p>
      </div>
    </div>
  </div>
</footer>
