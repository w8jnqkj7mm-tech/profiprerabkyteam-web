---
interface Props {
  size?: number;
  variant?: 'dark' | 'light';
}

const { size = 64, variant = 'light' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 120 140"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Pán Vodár"
>
  <!-- Outline figure with crossed arms -->
  <g class:list={['plumber-logo', variant]}>
    <!-- Head -->
    <circle cx="60" cy="30" r="16" stroke={variant === 'light' ? 'white' : 'currentColor'} stroke-width="2" fill="none" />
    <!-- Blue cap -->
    <path d="M45 28 L75 28 L72 20 L48 20 Q45 25 45 28" fill={variant === 'light' ? '#8FA6E6' : '#8FA6E6'} />
    <!-- Body -->
    <path d="M45 46 L75 46 L72 70 L48 70 Z" stroke={variant === 'light' ? 'white' : 'currentColor'} stroke-width="2" fill="none" />
    <!-- Left arm with pipe wrench -->
    <path d="M45 50 L25 55" stroke={variant === 'light' ? 'white' : 'currentColor'} stroke-width="2" stroke-linecap="round" />
    <path d="M20 50 Q18 55 20 60" stroke={variant === 'light' ? 'white' : 'currentColor'} stroke-width="2.5" fill="none" stroke-linecap="round" />
    <!-- Right arm with valve/faucet -->
    <path d="M75 50 L95 55" stroke={variant === 'light' ? 'white' : 'currentColor'} stroke-width="2" stroke-linecap="round" />
    <path d="M98 52 Q102 55 100 60" stroke={variant === 'light' ? 'white' : 'currentColor'} stroke-width="2" fill="none" stroke-linecap="round" />
    <circle cx="100" cy="55" r="3" fill={variant === 'light' ? '#8FA6E6' : '#8FA6E6'} />
    <!-- Pipe detail -->
    <path d="M60 75 L60 95 L55 95" stroke={variant === 'light' ? '#8FA6E6' : '#8FA6E6'} stroke-width="2" fill="none" stroke-linecap="round" />
    <!-- Legs -->
    <path d="M52 70 L50 100" stroke={variant === 'light' ? 'white' : 'currentColor'} stroke-width="2" stroke-linecap="round" />
    <path d="M68 70 L70 100" stroke={variant === 'light' ? 'white' : 'currentColor'} stroke-width="2" stroke-linecap="round" />
    <!-- Text -->
    <text x="60" y="125" font-family="Montserrat" font-size="14" font-weight="600" text-anchor="middle" fill={variant === 'light' ? 'white' : 'currentColor'}>
      pán
    </text>
    <text x="60" y="140" font-family="Montserrat" font-size="12" font-weight="500" text-anchor="middle" fill={variant === 'light' ? 'white' : 'currentColor'}>
      vodár
    </text>
  </g>
</svg>

<style define:vars={{ size: `${size}px` }}>
  .plumber-logo.light {
    color: white;
  }
  .plumber-logo.dark {
    color: #0d1215;
  }
</style>
