---
const pillars = [
  {
    title: 'Vlastní ľudia',
    description: 'Murári, elektrikári, vodári aj stolári sú z jedného tímu. Žiadne prepojenia na externé spoločnosti a prebery medzitím.',
  },
  {
    title: 'Jeden zodpovedný majister',
    description: 'Vy volíte jedného člověka. On riešii poradie remesiel, materiál aj termíny. Všetko v jednej ruke.',
  },
  {
    title: 'Nadväznosť bez prestojov',
    description: 'Rozvody, povrchy a nábytok – všetko na seba navzájom nadväzuje. Bez čakania a bez zbytočného času.',
  },
];
---

<section class="bg-bg-dark py-16 md:py-24 px-clamp-sm">
  <div class="max-w-7xl mx-auto">
    <div class="mb-12">
      <p class="text-xs font-bold tracking-widest uppercase text-brand-green mb-4">PREČO JEDEN TÍM</p>
      <h2 class="text-4xl md:text-5xl font-bold leading-tight mb-8">Jedna zmluva. Jeden harmonogram.</h2>
      <p class="text-text-secondary italic text-lg max-w-3xl">Štyri remeslá, ktoré sa na staobe necákajú navzájom.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mt-16">
      {pillars.map((pillar) => (
        <div class="border-b border-text-muted pb-8">
          <h3 class="font-bold text-xl mb-4">{pillar.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">{pillar.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
